# ── Sequencer machine output folders ─────────────────────────────────────────
# Set the real path of each machine's output folder on THIS host machine.
# Add one variable per sequencer — names must match the volume lines in docker-compose.yml.
#
# Linux / Mac:
MACHINE_1_PATH=/data/sequencers/machine-1
#
# Windows:
# MACHINE_1_PATH=C:\Sequencer\Machine1
#
# Add more machines as needed:
# MACHINE_2_PATH=/data/sequencers/machine-2
