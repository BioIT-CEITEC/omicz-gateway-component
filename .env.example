# ── Sequencer machine output folders ─────────────────────────────────────────
# These variable names must match what is used in docker-compose.yml.
# Set each one to the real folder path on THIS computer.
#
# Linux / Mac example:
MACHINE_7_PATH=/data/sequencers/machine-7
MACHINE_1_PATH_SHARED=/data/sequencers/machine-1-shared
#
# Windows example:
# MACHINE_7_PATH=C:\Sequencer\Machine7
# MACHINE_1_PATH_SHARED=C:\Sequencer\Machine1Shared
