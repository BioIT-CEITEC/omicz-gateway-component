# ── Database ───────────────────────────────────────────────────────────────────
# These match the values hardcoded in docker-compose.yml — no change needed.
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fastapi_gateway_db

# ── Pagination ─────────────────────────────────────────────────────────────────
PAGINATION_DEFAULT_SKIP=0
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=50

# ── S3 Storage (all required) ──────────────────────────────────────────────────
S3_ENDPOINT=https://your-s3-endpoint
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_PREFIX=raw_run_data/
# Where the TRE writes its confirmation for each run (an empty <manifest>.CHECKSUM = OK)
S3_CHECKSUM_BUCKET=your-bucket-name
S3_CHECKSUM_PREFIX=checksums/
