# ── Database ───────────────────────────────────────────────────────────────────
# These match the values hardcoded in docker-compose.yml — no change needed.
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fastapi_gateway_db

# ── Pagination ─────────────────────────────────────────────────────────────────
PAGINATION_DEFAULT_SKIP=0
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=50

# ── S3 Storage ─────────────────────────────────────────────────────────────────
# Direct HTTPS endpoint — no kubectl or port-forward needed.
S3_ENDPOINT=https://omicz-s3proxy.dyn.cloud.e-infra.cz
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=us-east-1
S3_BUCKET=omicz-dev
S3_PREFIX=raw_run_data/
